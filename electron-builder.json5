// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.inkweaver.app",
  "asar": true,
  "asarUnpack": [
    "node_modules/apache-arrow/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lancedb/lancedb/**/*",
    "node_modules/@lancedb/lancedb-darwin-*/**/*",
    "node_modules/@lancedb/lancedb-linux-*/**/*",
    "node_modules/@lancedb/lancedb-win32-*/**/*",
    "node_modules/@lancedb/lancedb-win32-x64-msvc/**/*",
    // 本地向量模型推理的原生运行时与图像依赖：.node/.dll 必须落到磁盘才能加载。
    "node_modules/onnxruntime-node/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*"
  ],
  "afterPack": "scripts/linux-appimage-after-pack.cjs",
  "productName": "InkWeaver",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "build",
    // 浏览器端推理运行时只用于 Web，Electron 主进程走 onnxruntime-node，剔除以免安装包无谓增大。
    "!node_modules/onnxruntime-web/**/*"
  ],
  "mac": {
    // 每个平台只保留自己的原生库，其余平台的 onnxruntime 二进制不随包分发。
    "files": [
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*"
    ],
    "target": ["dmg"],
    "publish": [
      {
        "provider": "github",
        "owner": "shuishuipingan",
        "repo": "InkWeaver",
        "channel": "latest",
        "releaseType": "release",
        "publishAutoUpdate": true,
        "tagNamePrefix": "v"
      }
    ],
    "artifactName": "inkweaver-mac-${arch}-${version}-installer.${ext}",
    "category": "public.app-category.productivity",
    "extraResources": [
      {
        "from": "electron/security/darwin-safe-file-system",
        "to": "security/darwin-safe-file-system"
      }
    ]
  },
  "win": {
    "files": [
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*"
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shuishuipingan",
        "repo": "InkWeaver",
        "channel": "latest",
        "releaseType": "release",
        "publishAutoUpdate": true,
        "tagNamePrefix": "v"
      }
    ],
    "extraResources": [
      {
        "from": "electron/security/windows-safe-file-system.ps1",
        "to": "security/windows-safe-file-system.ps1"
      }
    ]
  },
  "nsis": {
    "artifactName": "inkweaver-setup-${version}.${ext}",
    "shortcutName": "织墨 InkWeaver",
    "uninstallDisplayName": "织墨 InkWeaver",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "files": [
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*"
    ],
    "target": ["AppImage", "deb", "rpm"],
    "artifactName": "inkweaver-linux-x64-${version}.${ext}",
    "maintainer": "InkWeaver Maintainers <shuishuipingan@users.noreply.github.com>",
    "category": "Office",
    "icon": "build/icon.png"
  },
  "deb": {
    "afterInstall": "scripts/linux-sandbox-post-install.sh"
  },
  "rpm": {
    "afterInstall": "scripts/linux-sandbox-post-install.sh"
  }
}
